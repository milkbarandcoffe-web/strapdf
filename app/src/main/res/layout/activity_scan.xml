<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp" android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:id="@+id/txtCount"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="18sp" android:text="0" />

        <Button android:id="@+id/btnShot"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="10dp" android:text="@string/scan_shot" />

        <Button android:id="@+id/btnDone"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:enabled="false" android:text="@string/scan_done" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
